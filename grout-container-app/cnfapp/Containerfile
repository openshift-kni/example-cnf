## Image to build webserver
FROM registry.access.redhat.com/ubi10/go-toolset:1.26 as build

WORKDIR /opt/app-root/src
COPY utils/webserver.go .
RUN go mod init webserver.go
RUN GOOS=linux CGO_ENABLED=0 go build -a -o webserver .

## grout image
FROM registry.access.redhat.com/ubi10/ubi:latest

LABEL name="NFV Example CNF Grout Application" \
      maintainer="telcoci" \
      vendor="fredco" \
      version="v0.2.13" \
      release="v0.2.13" \
      summary="An example CNF for platform validation" \
      description="An example CNF for platform validation"

COPY licenses /licenses

# check latest release from https://github.com/DPDK/grout/releases
ENV GROUT_VER v0.19.3
ENV GROUT_RPMS_URL https://github.com/DPDK/grout/releases/download/${GROUT_VER}

# frr needs libyang.so.2. That library is in RHEL AppStream, but not in the UBI
# subset. EPEL does not rebuild packages RHEL already ships, so enabling it does
# not help on an unsubscribed runner such as GitHub Actions. CentOS Stream
# AppStream has the same libyang the Grout RPMs are built against. The repo is
# removed after install; RHEL 10 rejects the CentOS GPG key because it is SHA-1.
RUN printf '%s\n' \
      '[centos-stream-libyang]' \
      'name=CentOS Stream 10 AppStream (libyang only)' \
      'baseurl=https://mirror.stream.centos.org/10-stream/AppStream/\$basearch/os/' \
      'enabled=1' \
      'gpgcheck=0' \
      'includepkgs=libyang' \
      > /etc/yum.repos.d/centos-stream-libyang.repo && \
    dnf -y install --nodocs --setopt=install_weak_deps=0 \
      libyang \
      ${GROUT_RPMS_URL}/frr.x86_64.rpm \
      ${GROUT_RPMS_URL}/grout-frr.x86_64.rpm \
      ${GROUT_RPMS_URL}/grout.x86_64.rpm \
      catatonit jq sudo iputils && \
    rm -f /etc/yum.repos.d/centos-stream-libyang.repo && \
    dnf clean all

# Create custom user to avoid using root account
RUN useradd -u 56560 -G frr example-cnf

# Assign frr user to the example-cnf group to be able to use the shared socket
RUN usermod -a -G example-cnf frr

# Allow example-cnf to use sudo permissions without asking for password
RUN echo -e "example-cnf\tALL=(ALL)\tNOPASSWD: ALL" > /etc/sudoers.d/example-cnf

# Copy scripts
COPY --chmod=550 --from=build /opt/app-root/src/webserver /usr/local/bin/webserver
COPY --chmod=755 scripts/grout-wrapper /grout-wrapper

# Move to the custom user
USER example-cnf

# Environment variables
ENV GROUT_SOCK_PATH=/run/grout/api.sock
# Required in containers so kernel ping(8) reaches grout instead of eth0,
# and ICMP replies delivered on control-plane TAPs are not dropped by rp_filter.
ENV GROUT_OVERRIDE_DEFAULT_ROUTE=true
ENV GROUT_OVERRIDE_RP_FILTER=true

# Prepare entrypoint
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/usr/libexec/catatonit/catatonit", "--", "/grout-wrapper"]
CMD ["grout"]
